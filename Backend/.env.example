# MedMove Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────
# Neon (or any PostgreSQL) connection string.
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────
# Must be a long, random secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
# Token lifetime in minutes (480 = 8 hours)
JWT_EXPIRES_MINUTES=480

# ── Seeded coordinator account ────────────────────────────────────────────
# These must match what was used when running scripts/seed_demo.py.
COORDINATOR_EMAIL=coordinator@medmove.test
COORDINATOR_PASSWORD=a-strong-coordinator-password

# ── Optimization defaults ─────────────────────────────────────────────────
# Budget in INR paise (500000 = Rs 5,000)
DEFAULT_OPTIMIZATION_BUDGET_MINOR_UNITS=500000
# Planning date used for automatic inventory-triggered optimization (YYYY-MM-DD)
DEFAULT_PLANNING_DATE=2027-01-15

# ── Authentication cookie ─────────────────────────────────────────────────
AUTH_COOKIE_NAME=medmove_access_token
# Set to true in production (HTTPS required)
AUTH_COOKIE_SECURE=false
# lax | strict | none  (use none only with Secure=true for cross-site)
AUTH_COOKIE_SAMESITE=lax
# Leave blank unless frontend and API share a cookie domain
AUTH_COOKIE_DOMAIN=

# ── CORS — allowed frontend origins ──────────────────────────────────────
# Comma-separated list. Must be explicit (never *) when allow_credentials=True.
# Local development:
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (Vercel):
# FRONTEND_ORIGINS=https://medmove.vercel.app
