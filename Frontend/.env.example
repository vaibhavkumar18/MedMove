# MedMove Frontend — Environment Variables
# Copy this file to .env and fill in the correct backend URL.
# Never commit .env to version control.
# All VITE_* variables are bundled into client-side code — never put secrets here.

# ── Backend API root (must end in /api/v1) ─────────────────────────────────
# Local development (Backend running on port 8000):
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production example (Render):
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1
